<Project>

  <!--
    Package policy: bump to the latest STABLE release monthly, all at once, across the
    dew_flow_* repositories (.claude/rules/shared/csharp/nuget-packages.md). Exceptions
    are pinned below with the reason, because an exception without a reason gets bumped
    by the next person who runs the sweep.
  -->
  <ItemGroup>
    <!-- coai-mcp: the official MCP SDK. Affordable under Native AOT — measured in
         dew_flow_creds_for_devs (2026-08-27): with PublishAot and
         JsonSerializerIsReflectionEnabledByDefault=false it publishes with zero trim
         warnings and answers a real initialize/tools-list exchange. MIT. -->
    <PackageVersion Include="ModelContextProtocol" Version="2.2.0" />

    <!-- The Team server's HTTP surface. JwtBearer validates the identity provider's tokens;
         Serilog.AspNetCore is what puts the host's own logging on the family's sinks. Both are the
         versions dew_flow_creds_for_devs runs, because the server mirrors its authentication and a
         pair that disagreed would be a difference nobody chose. -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <!-- Drives the server in-process for its tests: no port, no container, no network. -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <!-- Must not trail what JwtBearer 10.0.11 pulls in transitively: the test project mints its
         own tokens with this, and two versions of the same handler in one process is the kind of
         mismatch that only shows up as a signature nobody can validate. -->
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />

    <!-- The one logging stack, per .claude/rules/shared/common/logging-serilog.md.
         The console sink is our own AnsiConsoleSink (the packaged themes emit nothing
         once stdout is redirected - measured, see the rule); only the core pipeline
         and the file sink come from packages. Apache-2.0. -->
    <!-- The rounds database: every round, every reviewer and every FINDING with what the caller
         decided about it, which no file in the data directory held before. Microsoft's own
         provider rather than an ORM: hand-written SQL over SqliteCommand is what stays inside
         Native AOT, and the e_sqlite3 bundle publishes per RID. MIT. -->
    <!-- .Core plus the bundle chosen HERE, rather than the all-in-one Microsoft.Data.Sqlite: that
         one pins SQLitePCLRaw 2.1.11, whose native lib.e_sqlite3 carries GHSA-2m69-gcr7-jv3q (high),
         and this repository builds warnings-as-errors on advisories. The 3.x family is the fixed
         one. Apache-2.0 / MIT. -->
    <PackageVersion Include="Microsoft.Data.Sqlite.Core" Version="10.0.12" />
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />

    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />

    <!-- tree-sitter for the normalizer, and a STANDING PIN: this one does not move with the monthly
         latest-stable bump, it moves when we decide to move it having read what changed.

         Approved by the operator on 2026-09-15 under `csharp/nuget-packages.md`, which requires an
         individual's package to be asked about however popular it is. MIT, 205k downloads, six
         releases between 2025-05-04 and 2026-01-22 — fresh, but published by one person
         (Marius Greuel), and that is the whole reason for the pin.

         It is here rather than a hand-written P/Invoke because of what it CARRIES: prebuilt native
         grammars for eight RIDs. Writing the binding is easy; sourcing and building the grammars is
         the part that is not, and doing it ourselves was the cost that nearly bought a Rust
         toolchain. The publish drops every grammar but c-sharp/typescript/javascript — about 60 MB
         per RID of languages nobody here parses.

         EXEMPT FROM THE MONTHLY LATEST-STABLE BUMP. Not because staying current is wrong, but
         because a bump here changes NATIVE binaries that two checks are written against by
         name: the DropGrammarsNobodyParses target prunes by filename, and the release workflow
         asserts the archive holds exactly the grammars shared/kept-grammars.txt lists. Neither
         is something the compiler sees. Upgrade deliberately, re-run the publish and count the
         grammars - ThePinThatMustNotDriftTests fails until the version here is changed on
         purpose. -->
    <PackageVersion Include="TreeSitter.DotNet" Version="1.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- xUnit v3 on the native Microsoft Testing Platform: the test project builds into a
         self-contained runner executable. There is no VSTest testhost here, so `dotnet test`
         aborts — run the executable (.claude/rules/shared/common/testing.md). -->
    <PackageVersion Include="xunit.v3" Version="4.0.1" />

    <!-- 7.2.2 = the last Apache-2.0 release; 8.x moved to the Xceed Community License
         (non-commercial only). Do NOT bump. -->
    <PackageVersion Include="FluentAssertions" Version="7.2.2" />
  </ItemGroup>

</Project>
