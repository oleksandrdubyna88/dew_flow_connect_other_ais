{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Edit",
      "Write",
      "NotebookEdit",
      "Bash",
      "PowerShell"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/load-instructions.mjs"
          }
        ]
      }
    ]
  }
}
