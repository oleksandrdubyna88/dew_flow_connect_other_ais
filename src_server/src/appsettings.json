{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "Coai": {
    "DataDir": "/data",
    "SessionTtlDays": 7,
    "RequireForwardedHttps": true,
    "RateLimit": {
      "PermitLimit": 120,
      "WindowSeconds": 10
    }
  }
}
