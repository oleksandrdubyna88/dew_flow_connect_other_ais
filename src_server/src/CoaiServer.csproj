<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <AssemblyName>coai-server</AssemblyName>
    <RootNamespace>CoaiServer</RootNamespace>
    <!-- The release tag names this; a local build says so rather than claiming 1.0.0. -->
    <Version>0.0.0</Version>
    <!-- Native AOT, the same choice as coai-mcp and the vault server: the trim and AOT analyzers
         then run on every ordinary build, so an incompatible pattern is a compile error rather
         than a discovery on a release runner. -->
    <PublishAot>true</PublishAot>
    <StripSymbols>true</StripSymbols>
    <!-- An accidental reflective serialization call is a compile error, not a runtime surprise. -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <!-- IL2104 comes from Serilog CORE's internals (reflection inside `@` destructuring, which no
         call site here uses). A library-internal warning we cannot fix; scoped here, never
         solution-wide. Same exemption, same reason, as the vault server. -->
    <NoWarn>$(NoWarn);IL2104</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Serilog.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <!-- Runners arrives with story 2.2, which is the first code here that CALLS it: the vendor
         probe, the not-signed-in diagnosis, and the one true list of runtime names that
         vendors.json is validated against. Story 2.1 removed it precisely because nothing used it
         yet, and an unused reference is not free under PublishAot — it pulls the assembly into this
         binary's trim and AOT closure, so a change over there can break a build over here before
         anything here uses it. Core is still absent for that reason; 2.3 brings it with the jobs. -->
    <ProjectReference Include="..\..\src_mcp\runners\CoaiMcp.Runners.csproj" />
    <ProjectReference Include="..\..\src_mcp\service_defaults\CoaiMcp.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CoaiServer.Tests" />
  </ItemGroup>

</Project>
