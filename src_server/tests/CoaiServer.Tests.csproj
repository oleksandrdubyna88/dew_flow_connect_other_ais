<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>CoaiServer.Tests</RootNamespace>
    <!-- xUnit v3 on Microsoft Testing Platform, like every other suite here: this builds into a
         self-contained runner. Run the executable; `dotnet test` has no VSTest host and aborts. -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\CoaiServer.csproj" />
    <!-- The client's shim, in-process: the budget rule (story 4.3 of todo/PLAN_every_round_is_counted.md) is tested
         against the POST the real ask-remote shim code builds for a launch, never against a hand-built request: the
         shim's own ten seconds are the number a hand-built one misses. -->
    <ProjectReference Include="..\..\src_mcp\src\CoaiMcp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ledger lines copied, redacted, from the live Team server (story 1.2 of
         todo/PLAN_every_round_is_counted.md): what the deployed server WRITES, as bytes, so a reader
         change is tested against history rather than against a line the test itself composed. -->
    <None Update="fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- At most 8 test threads (common.local-cpu-budget). The file must reach the output folder:
         measured 2026-10-11 on xunit.v3 4.0.1, an uncopied xunit.runner.json is never read and the
         runner takes one thread per CPU (24). A command-line max-threads switch still overrides it.
         Not on CI: maxParallelThreads is an exact number, so a 4-vCPU runner would be RAISED to 8. -->
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" Condition="'$(CI)' != 'true'" />
  </ItemGroup>

</Project>
