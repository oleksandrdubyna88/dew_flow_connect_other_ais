<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>CoaiBench.Tests</RootNamespace>
    <!-- xUnit v3 on Microsoft Testing Platform, as everywhere here: this builds into a runner.
         Run the executable; `dotnet test` has no VSTest host in this repository and aborts. -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="FluentAssertions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CoaiBench\CoaiBench.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- At most 8 test threads (common.local-cpu-budget). The file must reach the output folder:
         measured 2026-10-11 on xunit.v3 4.0.1, an uncopied xunit.runner.json is never read and the
         runner takes one thread per CPU (24). A command-line max-threads switch still overrides it. -->
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
