# ConnectOtherAIs Team server — the only file you configure.
#
#   cp .env.example .env
#   # edit the four REQUIRED values below, then:
#   docker compose up -d
#
# This file is an EXAMPLE and is committed. The real `.env` is git-ignored and lives only on
# the machine that runs the server. Nothing here is a secret; every value that is one is
# named here and set there.

# ---------------------------------------------------------------------------
# REQUIRED — the server refuses to start without these
# ---------------------------------------------------------------------------

# Who may sign in. Comma-separated email domains; anybody outside them is refused with 403
# and told so, because signing in again cannot fix being outside your company.
ALLOWED_DOMAINS=remsoft.dev

# Your Entra tenant id, and what a token for this server is allowed to say it is FOR.
# From the one-time app registration — see deploy/README.md.
MS_TENANT=
MS_AUDIENCES=
MS_CLIENT_SCOPE=

# ---------------------------------------------------------------------------
# Who can see the whole company's spending
# ---------------------------------------------------------------------------

# Comma-separated emails. Everybody sees their OWN usage; only these see `scope=company`,
# which the server refuses for anybody else with a 403. Empty means nobody, which is a
# legitimate setting — the per-person page still works for everyone.
ADMINS=

# ---------------------------------------------------------------------------
# The machine this runs on
# ---------------------------------------------------------------------------

# Where state lives on the HOST. Everything that must survive an update is under here:
# the signed-in vendor accounts, vendors.json, sessions, and usage.jsonl.
DATA_DIR=./data
LOG_DIR=./logs

# Loopback port the host nginx proxies to. 8090 was checked free on the target machine.
COAI_PORT=8090

# How many reviews may run AT ONCE. Deliberately 1 on a small box: each concurrent review is
# a full agentic CLI process, and the target machine has ~1.9 GB free with no swap. Raising
# this without raising MEM_LIMIT (and adding swap) is how this host OOMs — and the process
# the kernel picks may be postgres or the vault rather than this one.
MAX_CONCURRENCY=1

# The container's ceiling, so that the thing which dies when the above is wrong is OURS.
MEM_LIMIT=1500m

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

COAI_IMAGE=ghcr.io/oleksandrdubyna88/coai-server:latest

# Google sign-in is wired but OFF in v1: the company is on Entra and the domain allow-list is
# the point of the product. Turning it on later is these two lines and a restart, not a
# client release — the extension offers what the server advertises.
GOOGLE_ENABLED=false
GOOGLE_AUDIENCES=

# For the in-process test harness only. NEVER set on a real deployment: it enables a signing
# scheme that mints sessions without an identity provider.
LOCAL_SIGNING_KEY=

# nginx always sets X-Forwarded-Proto and this port is unreachable except through it — the two
# conditions that make trusting the header correct.
#
# THIS LIST DECIDES WHETHER THE SERVER WORKS AT ALL when REQUIRE_HTTPS is true. The HTTPS gate
# believes `X-Forwarded-Proto` only from a proxy named here — a header from anywhere else is a claim
# the caller made about itself, and is refused. So a proxy missing from this list means 403 on every
# route but /api/health.
#
# Loopback FIRST because it is what every deployment here actually has: a host nginx proxying to
# 127.0.0.1. The docker bridge range is second, for the compose shape where nginx is a container.
REQUIRE_HTTPS=true
TRUSTED_PROXIES=127.0.0.1/32,::1/128,172.16.0.0/12

SESSION_TTL_DAYS=7
QUEUE_WAIT_MINUTES=30
PER_CALLER_QUEUED=10
PER_CALLER_RUNNING=2
RATE_LIMIT_PERMITS=120
RATE_LIMIT_WINDOW_SECONDS=10
LOG_LEVEL=Information
