<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CoaiMcp.Runners</RootNamespace>
    <!-- The impure ring around the core: processes, worktrees, the scheduler. Everything here
         carries data to and from CoaiMcp.Core and adds no rules of its own. -->
    <IsAotCompatible>true</IsAotCompatible>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\core\CoaiMcp.Core.csproj" />
    <!-- For ONE thing: `JsonlLedger.AppendLine`, the repository's one append, which the spending
         ledger calls (story 1.4, 2026-09-21). ServiceDefaults is "how this process touches the data
         directory" — AOT-clean, Serilog its only package — and the alternative was a second copy of
         a FileShare bargain nobody re-derives. -->
    <ProjectReference Include="..\service_defaults\CoaiMcp.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- CA1502's threshold. The rule is switched on only for the security lane's files, in .editorconfig. -->
    <AdditionalFiles Include="..\CodeMetricsConfig.txt" />
    <!-- What each consultant runtime can be kept from reading, per platform, with the measurement or the
         source behind every row (PLAN_the_consultant_works_on_every_vendor.md, E3.3). Embedded for the reason
         Core's shared files are: a published Native-AOT binary runs where no shared/ directory exists, and
         ConsultantLimitations refuses to load without it rather than showing a row with no evidence. -->
    <EmbeddedResource Include="..\..\shared\consultant-limitations.json" LogicalName="CoaiMcp.Runners.consultant-limitations.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CoaiMcp.Tests" />
  </ItemGroup>

</Project>
