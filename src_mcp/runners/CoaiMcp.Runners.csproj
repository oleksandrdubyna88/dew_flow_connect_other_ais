<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CoaiMcp.Runners</RootNamespace>
    <!-- The impure ring around the core: processes, worktrees, the scheduler. Everything here
         carries data to and from CoaiMcp.Core and adds no rules of its own. -->
    <IsAotCompatible>true</IsAotCompatible>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <!-- `[LibraryImport]` in `Files/HandleRead`, `Files/PrivateFolderWindowsNative`, `Files/JunctionsNative` and `Kimi/HostProcessListNative`, which the source generator
         requires — the same reason ServiceDefaults has it: the generated marshalling is AOT-friendly where
         `[DllImport]` is not. No hand-written code here is `unsafe` (SonarCloud S6640 would say so). The files that
         need the imports say why: .NET has no managed way to ask a kernel what an OPEN handle names, or to read and
         replace the security of one, a read that re-opens by path follows a link swapped in after the check, a junction is made by a kernel call and not by cmd, and the
         process table is listed by a snapshot. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\core\CoaiMcp.Core.csproj" />
    <!-- For ONE thing: `JsonlLedger.AppendLine`, the repository's one append, which the spending
         ledger calls (story 1.4, 2026-09-21). ServiceDefaults is "how this process touches the data
         directory" — AOT-clean, Serilog its only package — and the alternative was a second copy of
         a FileShare bargain nobody re-derives. -->
    <ProjectReference Include="..\service_defaults\CoaiMcp.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- CA1502's threshold. The rule is switched on only for the security lane's files, in .editorconfig. -->
    <AdditionalFiles Include="..\CodeMetricsConfig.txt" />
    <!-- What each consultant runtime can be kept from reading, per platform, with the measurement or the
         source behind every row (PLAN_the_consultant_works_on_every_vendor.md, E3.3). Embedded for the reason
         Core's shared files are: a published Native-AOT binary runs where no shared/ directory exists, and
         ConsultantLimitations refuses to load without it rather than showing a row with no evidence. -->
    <EmbeddedResource Include="..\..\shared\consultant-limitations.json" LogicalName="CoaiMcp.Runners.consultant-limitations.json" />
    <!-- What a coai-owned VIBE_HOME may hold, per Vibe version (D17 of todo/PLAN_vibe_and_kimi_runtimes.md): generated by
         scripts/vibe-home-manifest.mjs, read by VibeHomeManifest before every Vibe launch. Embedded for the same reason. -->
    <EmbeddedResource Include="..\..\shared\vibe-home-manifest.json" LogicalName="CoaiMcp.Runners.vibe-home-manifest.json" />
    <!-- The model block coai writes into an owned KIMI_CODE_HOME's config.toml when the person has none of their own for the
         model a launch names, one per curated id (D10 and D19; E4.2 of todo/PLAN_vibe_and_kimi_runtimes_E4.md): read by
         KimiModelBlocks, whose ids ARE KimiModels.Curated. Embedded for the same reason. -->
    <EmbeddedResource Include="..\..\shared\kimi-model-blocks.json" LogicalName="CoaiMcp.Runners.kimi-model-blocks.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CoaiMcp.Tests" />
    <!-- The fake CLI plays the shim (E4.2 S2.43) and sets the lock seams in its own process. -->
    <InternalsVisibleTo Include="FakeCli" />
  </ItemGroup>

</Project>
