<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>coai-mcp</AssemblyName>
    <RootNamespace>CoaiMcp</RootNamespace>
    <!-- The version flag answers with this, and the release overrides it from the tag
         (dotnet publish -p:Version=…). Pinned to 0.0.0 rather than left to the SDK's 1.0.0:
         the panel compares what the binary reports against the newest published tag, so a local
         build claiming 1.0.0 would read as newer than every release and hide the update button. -->
    <Version>0.0.0</Version>
    <!-- Native AOT, the same choice as creds-mcp and for the same reason: an MCP client starts
         this process and waits for the handshake before it can list a single tool, so start-up
         is the user-visible cost. The trim/AOT analyzers then run on every ordinary build. -->
    <PublishAot>true</PublishAot>
    <StripSymbols>true</StripSymbols>
    <!-- An accidental reflective serialization call is a compile error, not a runtime surprise.
         The MCP SDK carries its own source-generated context (measured in creds, 2026-08-27). -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\core\CoaiMcp.Core.csproj" />
    <ProjectReference Include="..\runners\CoaiMcp.Runners.csproj" />
    <!-- The normalizer, as a MODE rather than a second binary. The release publishes one file per
         platform, and a companion executable beside it is one somebody eventually copies without.
         Its native grammars ride along exactly as e_sqlite3 already does — and the publish drops the
         ones no language here parses; see the pruning target below. -->
    <ProjectReference Include="..\normalizer\CoaiMcp.Normalizer.csproj" />
    <ProjectReference Include="..\service_defaults\CoaiMcp.ServiceDefaults.csproj" />
    <!-- The one migration runner, shared with `coai-bugs`. It was private to RoundsDb; the gate
         ruled against a second copy the day the other database reached a host. -->
    <ProjectReference Include="..\storage\CoaiMcp.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The shipped role-prompt defaults, INSIDE the binary. They were content files copied beside
         the executable until 2026-08-31, when the first real run died on every review_plan: the
         release asset carries one file, and tests never noticed because a project reference copies
         content into the test output. A default that can go missing is not a default. -->
    <EmbeddedResource Include="prompts\*.md" LogicalName="CoaiMcp.prompts.%(Filename)%(Extension)" />
    <!-- The consultant's prompt is served by RolePrompts under the same logical name family — so it
         is editable and restorable like every role prompt — but lives OUTSIDE prompts\: the
         extension's generate-help-prompts.mjs walks that folder and refuses any file the role seed
         does not name, and a consultation has no role. -->
    <EmbeddedResource Include="consultant\consult.md" LogicalName="CoaiMcp.prompts.consult.md" />
    <!-- The consultant's prompts for a consultation the cadence ORDERED (todo/PLAN_consult_on_a_cadence.md):
         a group of epics before it is built, and a piece the caller named as risky. Listed one by one like
         the first, for the same reason it is not a glob. -->
    <EmbeddedResource Include="consultant\consult-cadence.md" LogicalName="CoaiMcp.prompts.consult-cadence.md" />
    <EmbeddedResource Include="consultant\consult-risk.md" LogicalName="CoaiMcp.prompts.consult-risk.md" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CoaiMcp.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <KeptGrammarsFile>$(MSBuildThisFileDirectory)..\..\shared\kept-grammars.txt</KeptGrammarsFile>
  </PropertyGroup>

  <!--
    The binding ships 28+ grammars and this product parses three. Left alone that is 69 MB of a
    170 MB publish, per RID, on a file people download — Haskell, Verilog, Agda and twenty-five more
    that nothing here will ever hand to a parser.

    AFTER publish rather than by filtering the publish list: the native assets arrive through the
    package's own runtime-targets machinery, and deleting what landed is a rule anybody can read and
    verify against a directory listing, where a Remove over ResolvedFileToPublish is a rule you have
    to reason about. The release smoke checks the archive, which is where being wrong would matter.

    The names come from shared/kept-grammars.txt so that this target and the test that guards it
    cannot disagree. Both prefixes are covered because the platforms disagree: `tree-sitter-c-sharp.dll`
    on Windows, `libtree-sitter-c-sharp.so` on Linux.
  -->
  <Target Name="DropGrammarsNobodyParses" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <ReadLinesFromFile File="$(KeptGrammarsFile)">
      <Output TaskParameter="Lines" ItemName="_KeptGrammarLine" />
    </ReadLinesFromFile>

    <ItemGroup>
      <!-- The file carries its own explanation; the names are the lines that are not comments. -->
      <_KeptGrammar Include="@(_KeptGrammarLine)"
                    Condition="'%(Identity)' != '' AND !$([System.String]::Copy('%(Identity)').StartsWith('#'))" />

      <!-- Both spellings, because the platforms disagree about the `lib` prefix. -->
      <_KeepThese Include="@(_KeptGrammar);@(_KeptGrammar->'lib%(Identity)')" />

      <!-- Every grammar that landed, less the ones to keep. `MatchOnMetadata` compares the two
           lists by FILENAME, which is the only thing they have in common — one side is a full path
           under the publish directory and the other is a bare name out of a text file. Rebuilding
           paths from names was the first attempt and it silently deleted nothing. -->
      <_GrammarToDelete Include="$(PublishDir)tree-sitter*.*;$(PublishDir)libtree-sitter*.*" />
      <_GrammarToDelete Remove="@(_KeepThese)" MatchOnMetadata="Filename" />
    </ItemGroup>

    <Message Importance="high"
             Text="coai-mcp: keeping @(_KeptGrammar->Count()) grammar(s), dropping @(_GrammarToDelete->Count())." />
    <Delete Files="@(_GrammarToDelete)" />
  </Target>

</Project>
