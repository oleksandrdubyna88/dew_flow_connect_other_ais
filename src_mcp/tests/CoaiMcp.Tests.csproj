<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>CoaiMcp.Tests</RootNamespace>
    <!-- xUnit v3 on Microsoft Testing Platform: this builds into a self-contained runner.
         Run the executable; `dotnet test` has no VSTest host here and aborts. -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <!-- xUnit1051 (thread TestContext cancellation into every call) is suppressed deliberately:
         the integration suites here drive PanelService/git through APIs with optional tokens, and
         threading the context token through every call buys responsiveness on manual cancellation
         only, at the cost of noise on every line. Timeouts guard the processes themselves. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="FluentAssertions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\CoaiMcp.csproj" />
    <ProjectReference Include="..\core\CoaiMcp.Core.csproj" />
    <ProjectReference Include="..\runners\CoaiMcp.Runners.csproj" />
    <!-- The scriptable vendor stand-in: referenced so its binaries (dll + runtimeconfig) land
         beside the tests; run as `dotnet FakeCli.dll <verb>`, never loaded as a library. -->
    <ProjectReference Include="..\tests_fakecli\FakeCli.csproj" />
    <ProjectReference Include="..\service_defaults\CoaiMcp.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>
