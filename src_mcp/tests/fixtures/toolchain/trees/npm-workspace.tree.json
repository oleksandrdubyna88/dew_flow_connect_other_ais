{
  "description": "an npm workspace",
  "base": {
    "package.json": "{\n  \"name\": \"mono\",\n  \"version\": \"1.0.0\",\n  \"private\": true,\n  \"scripts\": {\n    \"test\": \"node --test\",\n    \"build\": \"npm run build --workspaces\"\n  },\n  \"devDependencies\": {},\n  \"workspaces\": [\n    \"packages/*\"\n  ]\n}\n",
    "package-lock.json": "{\n  \"name\": \"mono\",\n  \"version\": \"1.0.0\",\n  \"lockfileVersion\": 3,\n  \"requires\": true,\n  \"packages\": {}\n}\n",
    "packages/a/package.json": "{\n  \"name\": \"a\",\n  \"version\": \"1.0.0\",\n  \"private\": true,\n  \"scripts\": {\n    \"build\": \"tsc\"\n  },\n  \"devDependencies\": {}\n}\n",
    "packages/b/package.json": "{\n  \"name\": \"b\",\n  \"version\": \"1.0.0\",\n  \"private\": true,\n  \"scripts\": {\n    \"test\": \"jest\"\n  },\n  \"devDependencies\": {\n    \"jest\": \"^30.0.0\"\n  }\n}\n"
  },
  "heads": [
    {
      "name": "adds-a-project",
      "write": {
        "tools/package.json": "{\n  \"name\": \"tools\",\n  \"version\": \"1.0.0\",\n  \"private\": true,\n  \"scripts\": {\n    \"build\": \"node x.js\"\n  },\n  \"devDependencies\": {}\n}\n",
        "tools/package-lock.json": "{\n  \"name\": \"tools\",\n  \"version\": \"1.0.0\",\n  \"lockfileVersion\": 3,\n  \"requires\": true,\n  \"packages\": {}\n}\n"
      }
    },
    {
      "name": "removes-the-test-script",
      "write": {
        "package.json": "{\n  \"name\": \"mono\",\n  \"version\": \"1.0.0\",\n  \"private\": true,\n  \"scripts\": {\n    \"build\": \"npm run build --workspaces\"\n  },\n  \"devDependencies\": {},\n  \"workspaces\": [\n    \"packages/*\"\n  ]\n}\n"
      }
    },
    {
      "name": "adds-a-cargo-toml",
      "write": {
        "packages/a/Cargo.toml": "[package]\n"
      }
    },
    {
      "name": "renames-a-folder",
      "rename": [
        [
          "packages",
          "libs"
        ]
      ]
    }
  ]
}
