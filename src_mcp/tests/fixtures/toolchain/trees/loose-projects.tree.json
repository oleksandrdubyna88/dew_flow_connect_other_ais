{
  "description": "two project files with no solution",
  "base": {
    "tool/Tool.csproj": "<Project Sdk=\"Microsoft.NET.Sdk\"><PropertyGroup><TargetFramework>net10.0</TargetFramework></PropertyGroup><ItemGroup><ProjectReference Include=\"..\\shared\\Shared.csproj\" /></ItemGroup></Project>\n",
    "shared/Shared.csproj": "<Project Sdk=\"Microsoft.NET.Sdk\"><PropertyGroup><TargetFramework>net10.0</TargetFramework></PropertyGroup><ItemGroup></ItemGroup></Project>\n",
    "other/Other.Tests.csproj": "<Project Sdk=\"Microsoft.NET.Sdk\"><PropertyGroup><TargetFramework>net10.0</TargetFramework></PropertyGroup><ItemGroup><PackageReference Include=\"Microsoft.NET.Test.Sdk\" Version=\"17.14.1\" /><PackageReference Include=\"xunit\" Version=\"2.9.3\" /><PackageReference Include=\"xunit.runner.visualstudio\" Version=\"3.1.4\" /></ItemGroup></Project>\n",
    "global.json": "{ \"sdk\": { \"version\": \"10.0.100\", \"rollForward\": \"latestFeature\" } }\n"
  },
  "heads": [
    {
      "name": "adds-a-project",
      "write": {
        "extra/Extra.csproj": "<Project Sdk=\"Microsoft.NET.Sdk\"><PropertyGroup><TargetFramework>net10.0</TargetFramework></PropertyGroup><ItemGroup></ItemGroup></Project>\n"
      }
    },
    {
      "name": "removes-the-test-project",
      "remove": [
        "other/Other.Tests.csproj"
      ]
    },
    {
      "name": "adds-a-cargo-toml",
      "write": {
        "extra/Cargo.toml": "[package]\n"
      }
    },
    {
      "name": "renames-a-folder",
      "rename": [
        [
          "other",
          "renamed"
        ]
      ]
    }
  ]
}
