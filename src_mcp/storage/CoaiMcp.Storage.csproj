<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CoaiMcp.Storage</RootNamespace>
    <!-- The ONE SQLite migration runner, referenced by both binaries that own a database:
         `coai-mcp` (coai.db) and `coai-bugs` (coai-bugs.db). It was `RoundsDb.Migrate`, private to
         the first; the second reached a host with its schema in one statement and a note saying it
         would gain "the same discipline" when it shipped, and the gate ruled against a second copy
         — two runners drift, and the one that drifts is the one nobody re-reads.

         NOT in `CoaiMcp.Core`. That project is declared pure — no Process, no HttpClient, no
         filesystem — and a database file is the filesystem. The boundary there is held by review
         rather than by a test (a file reference is not visible as an assembly reference), which is
         exactly why this must not be the first thing to cross it.

         Referenced by two Native AOT hosts, so it must be trim-clean. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <!-- The provider only. The native bundle (`SQLitePCLRaw.bundle_e_sqlite3`) is each HOST's to
         reference: it publishes per RID beside that executable, and a library that carried it would
         make two hosts argue about which copy loads. -->
    <PackageReference Include="Microsoft.Data.Sqlite.Core" />
  </ItemGroup>

</Project>
