<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CoaiMcp.ServiceDefaults</RootNamespace>
    <!-- Referenced by the AOT host, so this library must be trim-clean too. -->
    <IsAotCompatible>true</IsAotCompatible>
    <!-- `[LibraryImport]` in `AppendOnlyFile`, which the source generator requires. It is here and
         not in a product project on purpose: the generated marshalling is AOT-friendly, where the
         reflection-based `[DllImport]` alternative is not, and this library is already in the AOT
         host's graph. Nothing else here is unsafe, and the one file that needs it says why in its
         own remarks: .NET has no managed way to ask a kernel to APPEND. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CoaiMcp.Tests" />

    <!-- `JsonlLedger` is INTERNAL, and these three are the only assemblies that may reach it: the
         spending ledger, the notices writer, and the measurement companion that drives the shipped
         call. The code round's point was that an allowlist test finds a fourth caller AFTER it is
         written, where a visibility boundary means it cannot be written — a caller outside these
         three cannot hand the primitive a root-derived path and a hand-built line at all. -->
    <InternalsVisibleTo Include="CoaiMcp.Runners" />
    <InternalsVisibleTo Include="NoticeTool" />
    <!-- `ResolvedDataDir` is minted by `PanelSettings.DataDirectoryFor` and by nothing else. Its
         constructor is internal and this is the one production assembly allowed to call it, so no
         other binary can mint a value whose guarantee comes from a resolver it does not share. -->
    <InternalsVisibleTo Include="coai-mcp" />
  </ItemGroup>

</Project>
