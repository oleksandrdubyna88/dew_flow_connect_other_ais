<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CoaiMcp.Normalizer</RootNamespace>
    <!-- The ONLY project that may name TreeSitter. The interface it implements lives in the pure
         core, which knows nothing of this dependency; an architecture test in CoaiMcp.Tests holds
         that line, because the whole point of the seam is that a native dependency does not leak.

         NOT referenced by CoaiMcp.csproj. That one is Native AOT and publishes one file per
         platform; a reference here would pull twenty-eight native grammars into it. The host for
         this library is decided in its own story. -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\core\CoaiMcp.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Version pinned in Directory.Packages.props, where the reason for the pin is written down. -->
    <PackageReference Include="TreeSitter.DotNet" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CoaiMcp.Tests" />
  </ItemGroup>

</Project>
