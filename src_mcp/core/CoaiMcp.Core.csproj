<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CoaiMcp.Core</RootNamespace>
    <!-- The pure core: findings, the sanitizer, the counting rule, the round state machine.
         No Process, no HttpClient, no filesystem — an architecture test in CoaiMcp.Tests holds
         the line. Everything here is a pure function under a unit test. -->
    <IsAotCompatible>true</IsAotCompatible>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <!-- The built-in role catalog: one file, read by both halves. This assembly embeds it — a
         default that lives beside the executable is a default that can go missing, which is how
         the first real run died on every review_plan — and the extension generates its copy
         from the same file. Both loaders are asserted against it. -->
    <EmbeddedResource Include="..\..\shared\builtin-roles.json" LogicalName="CoaiMcp.Core.builtin-roles.json" />

    <!-- The credential word list, and the same argument one step harder. A published Native-AOT
         binary runs where no shared/ directory exists, so a redactor that READ this file would
         throw there — and because every notice write is best-effort and swallows its exceptions,
         it would then redact with an empty list and put raw credentials into server-notices.jsonl.
         Two reviewers found that independently on the plan round. Embedded here, and
         CredentialWords refuses to start without it rather than redacting nothing. -->
    <EmbeddedResource Include="..\..\shared\credential-words.json" LogicalName="CoaiMcp.Core.credential-words.json" />

    <!-- The gate's command texts (issue #467): the words the orders are made of, which a person can
         override with <dataDir>/prompts/<id>.md. In shared/ because the extension's commands page
         shows the same defaults; embedded for the same reason as the two above. CommandTexts holds
         the one list of ids, and a test fails when a file and that list disagree. -->
    <EmbeddedResource Include="..\..\shared\commands\*.md" LogicalName="CoaiMcp.Core.commands.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CoaiMcp.Tests" />

    <!-- The parity check drives `Redaction` and `ServerNoticeLine` from a process node can start,
         and needs `NamedFields` to tell a known field from one that belongs in `more`. A test
         asset, like FakeCli: built by the solution, never published. -->
    <InternalsVisibleTo Include="NoticeTool" />
    <!-- The projection asks the gate's own question — "is this the same defect?" — rather than
         growing a second answer to it. Named here instead of making the rule public, so it stays an
         implementation detail with one more reader. -->
    <InternalsVisibleTo Include="coai-mcp" />
  </ItemGroup>

</Project>
