###

# @name company_scope_over_several_windows_counts_each_persons_rounds
GET {{baseUrl}}/api/usage?scope=company&windows=5h
Authorization: Bearer {{adminToken}}

?? status == 200

{{
  const assert = require('node:assert');
  test('the developer\'s codex row in the 5 h window carries the same counts as the company row', () => {
    const five = response.parsedBody.windows[0];
    const company = five.vendors.find((v) => v.vendor === 'codex');
    const dev = five.people.find((p) => p.email === 'dev@example.com').vendors.find((v) => v.vendor === 'codex');
    for (const row of [company, dev]) {
      assert.deepStrictEqual([row.rounds, row.runsWithoutRound, row.retries, row.repairs, row.followUps, row.cancelled, row.noBudget],
        [2, 1, 1, 1, 1, 1, 1]);
    }
  });
}}

