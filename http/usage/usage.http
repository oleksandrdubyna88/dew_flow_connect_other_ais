# What the team is spending. A read, so every request here is prod-safe — except where a request's
# assertion depends on the ONE ledger line the runner seeds (`run-contracts.mjs`), which a live server
# does not have: those are untagged, and their `@prod` twins assert only the shape of whatever rows
# the live server has. The seeded requests ask for `window=year`, which cannot miss a line stamped
# seconds ago even when the run straddles UTC midnight; the default `today` window could.

# @name usage_returns_my_own_spending_and_the_range_it_used
# @prod
GET {{baseUrl}}/api/usage
Authorization: Bearer {{token}}

?? status == 200

{{
  const assert = require('node:assert');
  test('vendors is a list and the scope says whose answer this is', () => {
    assert.ok(Array.isArray(response.parsedBody.vendors));
    assert.strictEqual(response.parsedBody.scope, 'me');
  });
  test('the range is named, because "today" is a word and this is the answer', () => {
    assert.ok(Date.parse(response.parsedBody.fromUtc) <= Date.parse(response.parsedBody.toUtc));
  });
  test('a torn line is an operator problem and is not reported to a person', () => {
    assert.strictEqual(response.parsedBody.unreadableLines, null);
  });
  test('every vendor row — however many there are — carries its models, and they sum to the vendor', () => {
    for (const vendor of response.parsedBody.vendors) {
      assert.ok(Array.isArray(vendor.models));
      for (const model of vendor.models) {
        assert.deepStrictEqual(
          Object.keys(model).sort(),
          ['costIsFloor', 'costUsd', 'failed', 'model', 'runs', 'tokensIn', 'tokensOut', 'unpricedRuns']);
      }
      assert.strictEqual(vendor.models.reduce((sum, m) => sum + m.runs, 0), vendor.runs, 'the models sum to their vendor');
    }
  });
  test('the personal answer has no chart — absent, not null, so a client reads absence as "not the company answer"', () => {
    assert.ok(!('daily' in response.parsedBody));
  });
}}

###

# The seeded line, seen through the personal answer: this is what makes the model shape above a
# checked thing rather than a loop over nothing.

# @name usage_over_a_year_shows_the_seeded_launch_under_its_vendor_and_model
GET {{baseUrl}}/api/usage?window=year
Authorization: Bearer {{token}}

?? status == 200

{{
  const assert = require('node:assert');
  test('the developer has the one vendor the runner seeded, with the one model under it', () => {
    assert.ok(response.parsedBody.vendors.length >= 1, 'no vendor row: the seeded ledger line was not read');
    const codex = response.parsedBody.vendors.find((v) => v.vendor === 'codex');
    assert.ok(codex, 'the seeded vendor is "codex", in the canonical lower-case spelling');
    assert.ok(codex.models.length >= 1, 'the vendor row has no model breakdown');
    assert.ok(codex.models.some((m) => m.model === 'gpt-5.6-luna'), 'the seeded model is not under its vendor');
    assert.strictEqual(codex.models.reduce((sum, m) => sum + m.runs, 0), codex.runs);
  });
}}

###

# @name usage_accepts_each_window_it_documents
# @prod
GET {{baseUrl}}/api/usage?window=week
Authorization: Bearer {{token}}

?? status == 200

{{
  const assert = require('node:assert');
  test('week is the last seven days, and the answer says so rather than leaving it to the name', () => {
    const days = (Date.parse(response.parsedBody.toUtc) - Date.parse(response.parsedBody.fromUtc)) / 86400000;
    assert.ok(days > 6.9 && days < 7.1, `expected about 7 days, got ${days}`);
  });
}}

