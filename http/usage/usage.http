# @name usage_over_several_windows_has_the_shape_a_client_reads
# @prod
GET {{baseUrl}}/api/usage?windows=5h,24h,week
Authorization: Bearer {{token}}

?? status == 200

{{
  const assert = require('node:assert');
  test('three windows by name, each with its range and its vendor rows', () => {
    const windows = response.parsedBody.windows;
    assert.deepStrictEqual(windows.map((w) => w.window), ['5h', '24h', 'week']);
    for (const window of windows) {
      assert.ok(Date.parse(window.fromUtc) < Date.parse(window.toUtc));
      assert.ok(Array.isArray(window.vendors) && Array.isArray(window.people));
    }
  });
}}

