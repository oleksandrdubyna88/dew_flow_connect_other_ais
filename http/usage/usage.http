###

# @name company_scope_answers_an_admin_with_people_and_the_unreadable_count
# @prod
GET {{baseUrl}}/api/usage?scope=company
Authorization: Bearer {{adminToken}}

?? status == 200

{{
  const assert = require('node:assert');
  test('people is a list rather than null, even when nobody has spent anything', () => {
    assert.strictEqual(response.parsedBody.scope, 'company');
    assert.ok(Array.isArray(response.parsedBody.people));
  });
  test('an admin IS told how many lines could not be read', () => {
    assert.strictEqual(typeof response.parsedBody.unreadableLines, 'number');
  });
  test('each vendor row — however many there are — is broken down by model, with the cost trio its vendor row carries', () => {
    for (const vendor of response.parsedBody.vendors) {
      assert.ok(Array.isArray(vendor.models));
      for (const model of vendor.models) {
        assert.strictEqual(typeof model.model, 'string');
        assert.strictEqual(typeof model.costIsFloor, 'boolean');
        assert.strictEqual(typeof model.unpricedRuns, 'number');
      }
      assert.strictEqual(vendor.models.reduce((sum, m) => sum + m.runs, 0), vendor.runs, 'the models sum to their vendor');
    }
  });
  test('the chart is thirty dense UTC calendar days, each a yyyy-MM-dd string with a row per vendor', () => {
    const daily = response.parsedBody.daily;
    assert.ok(daily, 'no daily on the company answer — an older server, or the chart was dropped');
    assert.ok(Date.parse(daily.fromUtc) < Date.parse(daily.toUtc));
    assert.strictEqual(daily.days.length, 30);
    for (const day of daily.days) {
      assert.match(day.day, /^\d{4}-\d{2}-\d{2}$/);
      assert.ok(Array.isArray(day.vendors));
      for (const bar of day.vendors) {
        assert.strictEqual(typeof bar.vendor, 'string');
        assert.strictEqual(typeof bar.runs, 'number');
      }
    }
    // The last bucket is the day before the range's exclusive end — read off the answer itself, so a
    // run that crosses UTC midnight between the server's clock and this one cannot disagree with it.
    const lastDay = new Date(Date.parse(daily.toUtc) - 86400000).toISOString().slice(0, 10);
    assert.strictEqual(daily.days[29].day, lastDay, 'the last bucket is today in UTC: the day before toUtc');
  });
}}

###

# The seeded line, counted by the company summary AND by the chart: the two are aggregated separately
# from one scan, and this is the request that would notice one of them losing it.

# @name company_scope_over_a_year_counts_the_seeded_launch_in_the_summary_and_in_the_chart
GET {{baseUrl}}/api/usage?scope=company&window=year
Authorization: Bearer {{adminToken}}

?? status == 200

{{
  const assert = require('node:assert');
  test('the summary has the seeded vendor with its model', () => {
    const codex = response.parsedBody.vendors.find((v) => v.vendor === 'codex');
    assert.ok(codex, 'the seeded ledger line was not read into the summary');
    assert.ok(codex.models.some((m) => m.model === 'gpt-5.6-luna'));
    assert.ok(response.parsedBody.people.some((p) => p.email === 'dev@example.com'), 'the seeded line is the developer\'s');
  });
  test('the chart counts the seeded launch — stamped seconds ago, so inside its thirty days whatever the window', () => {
    const launches = response.parsedBody.daily.days.flatMap((d) => d.vendors).reduce((sum, bar) => sum + bar.runs, 0);
    assert.ok(launches >= 1, 'the runner seeds one launch today, and the chart does not show it');
    const vendors = new Set(response.parsedBody.daily.days.flatMap((d) => d.vendors).map((bar) => bar.vendor));
    assert.ok(vendors.has('codex'), 'the chart names the vendor exactly as the summary does');
  });
}}

