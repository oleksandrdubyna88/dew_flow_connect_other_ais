# What the team is spending. A read, so every request here is prod-safe — except where a request's
# assertion depends on the ONE ledger line the runner seeds (`run-contracts.mjs`), which a live server
# does not have: those are untagged, and their `@prod` twins assert only the shape of whatever rows
# the live server has. The seeded requests ask for `window=year`, which cannot miss a line stamped
# seconds ago even when the run straddles UTC midnight; the default `today` window could.

# @name usage_returns_my_own_spending_and_the_range_it_used
# @prod
GET {{baseUrl}}/api/usage
Authorization: Bearer {{token}}

?? status == 200

{{
  const assert = require('node:assert');
  test('vendors is a list and the scope says whose answer this is', () => {
    assert.ok(Array.isArray(response.parsedBody.vendors));
    assert.strictEqual(response.parsedBody.scope, 'me');
  });
  test('the range is named, because "today" is a word and this is the answer', () => {
    assert.ok(Date.parse(response.parsedBody.fromUtc) <= Date.parse(response.parsedBody.toUtc));
  });
  test('a torn line is an operator problem and is not reported to a person', () => {
    assert.strictEqual(response.parsedBody.unreadableLines, null);
  });
  test('every vendor row — however many there are — carries its models, and they sum to the vendor', () => {
    for (const vendor of response.parsedBody.vendors) {
      assert.ok(Array.isArray(vendor.models));
      for (const model of vendor.models) {
        assert.deepStrictEqual(
          Object.keys(model).sort(),
          ['costIsFloor', 'costUsd', 'failed', 'model', 'runs', 'tokensIn', 'tokensOut', 'unpricedRuns']);
      }
      assert.strictEqual(vendor.models.reduce((sum, m) => sum + m.runs, 0), vendor.runs, 'the models sum to their vendor');
    }
  });
  test('the personal answer has no chart — absent, not null, so a client reads absence as "not the company answer"', () => {
    assert.ok(!('daily' in response.parsedBody));
  });
}}

###

# The seeded line, seen through the personal answer: this is what makes the model shape above a
# checked thing rather than a loop over nothing.

# @name usage_over_a_year_shows_the_seeded_launch_under_its_vendor_and_model
GET {{baseUrl}}/api/usage?window=year
Authorization: Bearer {{token}}

?? status == 200

{{
  const assert = require('node:assert');
  test('the developer has the one vendor the runner seeded, with the one model under it', () => {
    assert.ok(response.parsedBody.vendors.length >= 1, 'no vendor row: the seeded ledger line was not read');
    const codex = response.parsedBody.vendors.find((v) => v.vendor === 'codex');
    assert.ok(codex, 'the seeded vendor is "codex", in the canonical lower-case spelling');
    assert.ok(codex.models.length >= 1, 'the vendor row has no model breakdown');
    assert.ok(codex.models.some((m) => m.model === 'gpt-5.6-luna'), 'the seeded model is not under its vendor');
    assert.strictEqual(codex.models.reduce((sum, m) => sum + m.runs, 0), codex.runs);
  });
}}

###

# @name usage_accepts_each_window_it_documents
# @prod
GET {{baseUrl}}/api/usage?window=week
Authorization: Bearer {{token}}

?? status == 200

{{
  const assert = require('node:assert');
  test('week is the last seven days, and the answer says so rather than leaving it to the name', () => {
    const days = (Date.parse(response.parsedBody.toUtc) - Date.parse(response.parsedBody.fromUtc)) / 86400000;
    assert.ok(days > 6.9 && days < 7.1, `expected about 7 days, got ${days}`);
  });
}}

###

# @name an_unknown_window_is_refused_naming_the_legal_ones
GET {{baseUrl}}/api/usage?window=fortnight
Authorization: Bearer {{token}}

?? status == 400

{{
  const assert = require('node:assert');
  test('all four names are in the message', () => {
    for (const name of ['today', 'week', 'month', 'year']) {
      assert.match(response.parsedBody.error, new RegExp(name));
    }
  });
}}

###

# The company view is the admin one, and the refusal names the setting so somebody can ask the right
# person for it.

# @name company_scope_is_refused_to_a_non_admin
GET {{baseUrl}}/api/usage?scope=company
Authorization: Bearer {{token}}

?? status == 403

{{
  const assert = require('node:assert');
  test('it names Coai:Admins', () => {
    assert.match(response.parsedBody.error, /Coai:Admins/);
  });
}}

###

# @name company_scope_answers_an_admin_with_people_and_the_unreadable_count
# @prod
GET {{baseUrl}}/api/usage?scope=company
Authorization: Bearer {{adminToken}}

?? status == 200

{{
  const assert = require('node:assert');
  test('people is a list rather than null, even when nobody has spent anything', () => {
    assert.strictEqual(response.parsedBody.scope, 'company');
    assert.ok(Array.isArray(response.parsedBody.people));
  });
  test('an admin IS told how many lines could not be read', () => {
    assert.strictEqual(typeof response.parsedBody.unreadableLines, 'number');
  });
  test('each vendor row — however many there are — is broken down by model, with the cost trio its vendor row carries', () => {
    for (const vendor of response.parsedBody.vendors) {
      assert.ok(Array.isArray(vendor.models));
      for (const model of vendor.models) {
        assert.strictEqual(typeof model.model, 'string');
        assert.strictEqual(typeof model.costIsFloor, 'boolean');
        assert.strictEqual(typeof model.unpricedRuns, 'number');
      }
      assert.strictEqual(vendor.models.reduce((sum, m) => sum + m.runs, 0), vendor.runs, 'the models sum to their vendor');
    }
  });
  test('the chart is thirty dense UTC calendar days, each a yyyy-MM-dd string with a row per vendor', () => {
    const daily = response.parsedBody.daily;
    assert.ok(daily, 'no daily on the company answer — an older server, or the chart was dropped');
    assert.ok(Date.parse(daily.fromUtc) < Date.parse(daily.toUtc));
    assert.strictEqual(daily.days.length, 30);
    for (const day of daily.days) {
      assert.match(day.day, /^\d{4}-\d{2}-\d{2}$/);
      assert.ok(Array.isArray(day.vendors));
      for (const bar of day.vendors) {
        assert.strictEqual(typeof bar.vendor, 'string');
        assert.strictEqual(typeof bar.runs, 'number');
      }
    }
    // The last bucket is the day before the range's exclusive end — read off the answer itself, so a
    // run that crosses UTC midnight between the server's clock and this one cannot disagree with it.
    const lastDay = new Date(Date.parse(daily.toUtc) - 86400000).toISOString().slice(0, 10);
    assert.strictEqual(daily.days[29].day, lastDay, 'the last bucket is today in UTC: the day before toUtc');
  });
}}

###

# The seeded line, counted by the company summary AND by the chart: the two are aggregated separately
# from one scan, and this is the request that would notice one of them losing it.

# @name company_scope_over_a_year_counts_the_seeded_launch_in_the_summary_and_in_the_chart
GET {{baseUrl}}/api/usage?scope=company&window=year
Authorization: Bearer {{adminToken}}

?? status == 200

{{
  const assert = require('node:assert');
  test('the summary has the seeded vendor with its model', () => {
    const codex = response.parsedBody.vendors.find((v) => v.vendor === 'codex');
    assert.ok(codex, 'the seeded ledger line was not read into the summary');
    assert.ok(codex.models.some((m) => m.model === 'gpt-5.6-luna'));
    assert.ok(response.parsedBody.people.some((p) => p.email === 'dev@example.com'), 'the seeded line is the developer\'s');
  });
  test('the chart counts the seeded launch — stamped seconds ago, so inside its thirty days whatever the window', () => {
    const launches = response.parsedBody.daily.days.flatMap((d) => d.vendors).reduce((sum, bar) => sum + bar.runs, 0);
    assert.ok(launches >= 1, 'the runner seeds one launch today, and the chart does not show it');
    const vendors = new Set(response.parsedBody.daily.days.flatMap((d) => d.vendors).map((bar) => bar.vendor));
    assert.ok(vendors.has('codex'), 'the chart names the vendor exactly as the summary does');
  });
}}

