# Submit, watch, cancel — for real, and NOTHING reaches a vendor.
#
# The suite's stack has one vendor in the allowlist and no account signed in for it. So the request
# is accepted, the job is queued, and the runner refuses to start it because there is nobody to run
# it as. 202, 200 and 204 are real answers from real state, at zero subscription cost.

# @name a_review_is_accepted_and_queued
POST {{baseUrl}}/api/reviews
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "vendor": "codex",
  "model": "gpt-5.6-luna",
  "prompt": "review this",
  "role": "Architecture",
  "timeoutSeconds": 60
}

?? status == 202

{{
  const assert = require('node:assert');
  test('it comes back with an id and a queue position', () => {
    assert.match(response.parsedBody.id, /^\d+-[0-9a-f]{32}$/);
    assert.ok(Number.isInteger(response.parsedBody.position));
  });
  exports.reviewId = response.parsedBody.id;
}}

###

# @name a_queued_review_can_be_polled
GET {{baseUrl}}/api/reviews/{{reviewId}}
Authorization: Bearer {{token}}

?? status == 200

{{
  const assert = require('node:assert');
  test('every field of the status is present and typed, not null', () => {
    assert.strictEqual(response.parsedBody.status, 'queued');
    assert.strictEqual(typeof response.parsedBody.answer, 'string');
    assert.strictEqual(typeof response.parsedBody.failure, 'string');
    assert.strictEqual(typeof response.parsedBody.reason, 'string');
    // Story 3.2 of todo/PLAN_every_round_is_counted.md: the cause is a string field, empty until a cancellation.
    assert.strictEqual(response.parsedBody.endCause, '');
    assert.ok(Number.isInteger(response.parsedBody.tokensIn));
  });
}}

###

# A poll of an unfinished job with a short wait returns when the wait runs out, not never.

# @name polling_with_a_wait_returns_within_its_budget
GET {{baseUrl}}/api/reviews/{{reviewId}}?wait=2
Authorization: Bearer {{token}}

?? status == 200

###

# @name another_person_may_not_read_it
GET {{baseUrl}}/api/reviews/{{reviewId}}
Authorization: Bearer {{adminToken}}

?? status == 403

{{
  const assert = require('node:assert');
  test('the refusal says whose it is rather than pretending it does not exist', () => {
    assert.match(response.parsedBody.error, /somebody else/i);
  });
}}

###

# @name a_review_can_be_cancelled
DELETE {{baseUrl}}/api/reviews/{{reviewId}}
Authorization: Bearer {{token}}

?? status == 204

###

# The proof the cancel did something, and that a cancelled job says WHY rather than just stopping.

# @name a_cancelled_review_reports_itself_as_cancelled
GET {{baseUrl}}/api/reviews/{{reviewId}}
Authorization: Bearer {{token}}

?? status == 200

{{
  const assert = require('node:assert');
  test('it is failed, with cancelled as the reason', () => {
    assert.strictEqual(response.parsedBody.status, 'failed');
    assert.strictEqual(response.parsedBody.failure, 'cancelled');
  });
  test('and it says WHY as a word — withdrawn by this caller, never a sentence to match (story 3.2)', () => {
    assert.strictEqual(response.parsedBody.endCause, 'withdrawn');
  });
}}

###

# @name cancelling_a_second_time_is_not_found
DELETE {{baseUrl}}/api/reviews/{{reviewId}}
Authorization: Bearer {{token}}

?? status == 404

###

# Story 4.2 of todo/PLAN_every_round_is_counted.md: a request may carry the client's round id, its word for the
# request and the seconds left on its own deadline. They are bound as raw JSON and read by hand — through THIS
# server's source-generated binding, which no in-process test reaches — so a well-formed set is taken silently and a
# malformed one is dropped with a note, never refused.

# @name a_review_carrying_its_round_is_accepted_with_nothing_dropped
POST {{baseUrl}}/api/reviews
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "vendor": "codex",
  "model": "gpt-5.6-luna",
  "prompt": "review this",
  "role": "Architecture",
  "timeoutSeconds": 60,
  "round": "0123456789abcdef0123456789abcdef",
  "attempt": "repair",
  "remainingSeconds": 50
}

?? status == 202

{{
  const assert = require('node:assert');
  test('nothing was dropped: the three fields were read, not refused and not ignored', () => {
    // A response with no notes sends `dropped: null` (ReviewAcceptedDto) — the list exists only when something was dropped.
    assert.strictEqual(response.parsedBody.dropped, null);
  });
  exports.roundReviewId = response.parsedBody.id;
}}

###

# @name the_review_carrying_its_round_is_withdrawn
DELETE {{baseUrl}}/api/reviews/{{roundReviewId}}
Authorization: Bearer {{token}}

?? status == 204

###

# @name malformed_counting_fields_are_dropped_with_a_note_never_refused
POST {{baseUrl}}/api/reviews
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "vendor": "codex",
  "model": "gpt-5.6-luna",
  "prompt": "review this",
  "role": "Architecture",
  "timeoutSeconds": 60,
  "round": "oops",
  "attempt": {},
  "remainingSeconds": 1.5
}

?? status == 202

{{
  const assert = require('node:assert');
  test('accepted, and each malformed field is named in a note with its reason', () => {
    assert.deepStrictEqual(response.parsedBody.dropped.map((note) => note.field), ['round', 'attempt', 'remainingSeconds']);
    for (const note of response.parsedBody.dropped) {
      assert.strictEqual(typeof note.reason, 'string');
      assert.ok(note.reason.length > 0);
    }
  });
  exports.malformedRoundReviewId = response.parsedBody.id;
}}

###

# @name the_review_with_malformed_counting_fields_is_withdrawn
DELETE {{baseUrl}}/api/reviews/{{malformedRoundReviewId}}
Authorization: Bearer {{token}}

?? status == 204

###

# @uncovered `failure: "no_budget"` on GET /api/reviews/{id} (story 4.3 of todo/PLAN_every_round_is_counted.md) — the
#            server ends a job whose caller can no longer wait AT CLAIM, and a claim needs a signed-in account, which
#            this suite's stack deliberately has none of (nothing may reach a vendor). The in-process host proves the
#            name on the wire: `TheCallerCanStillWaitTests.TheConfiguredAllowance_IsWhatTheClaimReads`.

###

# @name a_model_the_allowlist_does_not_have_is_refused_naming_what_it_does
POST {{baseUrl}}/api/reviews
Authorization: Bearer {{token}}
Content-Type: application/json

{ "vendor": "codex", "model": "gpt-9-expensive", "prompt": "p" }

?? status == 400

{{
  const assert = require('node:assert');
  test('both the rejected name and the allowed one are in the message', () => {
    assert.match(response.parsedBody.error, /gpt-9-expensive/);
    assert.match(response.parsedBody.error, /gpt-5\.6-luna/);
  });
}}

###

# @name a_vendor_this_server_does_not_have_is_refused_naming_the_ones_it_does
POST {{baseUrl}}/api/reviews
Authorization: Bearer {{token}}
Content-Type: application/json

{ "vendor": "nope", "model": "gpt-5.6-luna", "prompt": "p" }

?? status == 400

{{
  const assert = require('node:assert');
  test('it lists what is available', () => {
    assert.match(response.parsedBody.error, /codex/);
  });
}}

###

# @name a_client_that_sends_no_kind_is_still_accepted
# The row every installed copy depends on. `coai-mcp --ask-remote` and every extension released
# before the field existed send no kind at all, and refusing them would take every round and every
# conversation on every machine down at once, on the day this server was deployed.
POST {{baseUrl}}/api/reviews
Authorization: Bearer {{token}}
Content-Type: application/json

{ "vendor": "codex", "model": "gpt-5.6-luna", "prompt": "p" }

?? status == 202

###

# @name a_chat_is_accepted_with_no_role
POST {{baseUrl}}/api/reviews
Authorization: Bearer {{token}}
Content-Type: application/json

{ "vendor": "codex", "model": "gpt-5.6-luna", "prompt": "explain this", "kind": "chat" }

?? status == 202

###

# @name a_repeated_submit_under_one_key_is_the_same_review
# The failure this answers: the POST arrives, the job is accepted, and the response is lost on the
# way back. Without the key the person pressing send again holds two slots for one question, on an
# account where a slot is the scarcest thing there is.
POST {{baseUrl}}/api/reviews
Authorization: Bearer {{token}}
Content-Type: application/json

{ "vendor": "codex", "model": "gpt-5.6-luna", "prompt": "the same question", "kind": "chat", "idempotencyKey": "contract-turn-1" }

?? status == 202

{{
  exports.firstId = response.parsedBody.id;
}}

###

# @name repeating_it_answers_with_that_same_id
POST {{baseUrl}}/api/reviews
Authorization: Bearer {{token}}
Content-Type: application/json

{ "vendor": "codex", "model": "gpt-5.6-luna", "prompt": "the same question", "kind": "chat", "idempotencyKey": "contract-turn-1" }

?? status == 202

{{
  const assert = require('node:assert');
  test('a retry is answered with the first job, and the client cannot tell', () => {
    assert.strictEqual(response.parsedBody.id, firstId);
  });
}}

###

# @name one_key_for_a_different_question_is_a_conflict
POST {{baseUrl}}/api/reviews
Authorization: Bearer {{token}}
Content-Type: application/json

{ "vendor": "codex", "model": "gpt-5.6-luna", "prompt": "an entirely different question", "kind": "chat", "idempotencyKey": "contract-turn-1" }

?? status == 409

{{
  const assert = require('node:assert');
  test('409, because the request is well formed and it is the two that disagree', () => {
    assert.match(response.parsedBody.error, /use a new key/);
  });
}}

