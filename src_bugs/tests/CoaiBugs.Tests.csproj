<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>CoaiBugs.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- xUnit v3 on the native Microsoft Testing Platform: this builds into a self-contained runner
         executable and is RUN, never `dotnet test` — there is no VSTest testhost here. -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>false</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" />
    <!-- Hosts the real server in-process. The decisions are unit-tested; the ROUTE, the bearer
         header and the AOT JSON binding are not part of them. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\CoaiBugs.csproj" />
    <ProjectReference Include="..\..\src_mcp\normalizer\CoaiMcp.Normalizer.csproj" />
    <!-- The CLIENT half. `BothHalvesTests` drives the real `UploadRun` against the real server,
         which is the live cross-implementation check the conventions require of a contract with two
         implementations — two suites agreeing with the same file is not that check. -->
    <ProjectReference Include="..\..\src_mcp\src\CoaiMcp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The released schema, frozen. `TheSchemaIsFrozenTests` holds step 1 of `CorpusSchema` against
         this file, which is what `bugs-v0.1.0` (f7e5170b) evaluates its `Schema` to and what the
         first host's database already contains. Copied beside the runner rather than located by
         walking up to the repository: a scenario over the published binary runs wherever the release
         workflow puts it. -->
    <!-- `Update`, not `Include`: the SDK's default `None` items already cover these files, so an
         `Include` adds a SECOND item for each one. It does not warn here today, which is exactly
         why it is worth fixing now rather than when something changes and it does. (CodeRabbit.) -->
    <None Update="fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
